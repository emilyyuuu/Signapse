# Tiger Cloud (Postgres + TimescaleDB) connection string
DATABASE_URL=
# API port
PORT=8787
# Allowed frontend origins, comma separated
CORS_ORIGIN=http://localhost:5173
# Gemini writes the clinical sentence; leave the key empty to use templates only.
# Get a key at https://aistudio.google.com/apikey. Server-side only, never VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=3000
# Max Gemini calls per minute across everyone; over it, rule-based sentences are used.
GEMINI_MAX_PER_MINUTE=30
# Per-client requests per minute: routes that call Gemini, and all writes.
RATE_LIMIT_GEMINI=30
RATE_LIMIT_WRITES=120
# Set to true only behind a hosting proxy (Render, Fly) so limits apply per real client.
TRUST_PROXY=false
# Lets the patient page start the pointing camera (apps/pointing) on this computer.
# Leave false on any hosted server: it launches a local program.
LOCAL_CAMERA=false
# The patient checks what they signed before it goes to the doctor. Set false to send straight through.
PATIENT_CONFIRM=true
# Urgent drafts (e.g. chest pain) send themselves after this many ms if the patient does not answer.
URGENT_AUTOSEND_MS=10000
# Frontend -> API base URL
VITE_API_URL=http://localhost:8787
# Optional TURN relay for call mode, when the patient and doctor can't connect directly.
VITE_TURN_URL=
VITE_TURN_USER=
VITE_TURN_PASS=
