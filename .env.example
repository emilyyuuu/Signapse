# Tiger Cloud (Postgres + TimescaleDB) connection string
DATABASE_URL=
# API port
PORT=8787
# Allowed frontend origins, comma separated
CORS_ORIGIN=http://localhost:5173
# Gemini writes the clinical sentence; leave the key empty to use templates only.
# Get a key at https://aistudio.google.com/apikey. Server-side only, never VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=2500
# Frontend -> API base URL
VITE_API_URL=http://localhost:8787
